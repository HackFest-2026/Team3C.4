# =====================================================================
# MINEGUARD — Root Environment Configuration (.env.example)
# ACDS Gold Mines — Edge Computing & Safety Platform
# =====================================================================

PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/mineguard
EDGE_MODE=autonomous_local
EDGE_STALE_TIMEOUT_MS=12000
VITE_API_URL=http://localhost:5000

# Roboflow PPE Detection Configuration (Helmet, Goggles, Mask)
ROBOFLOW_MODEL_URL=[PASTE MY ROBOFLOW MODEL URL HERE]
ROBOFLOW_API_KEY=[CONFIGURE MY ROBOFLOW API KEY SECURELY]
ROBOFLOW_VERSION=[USE THE VERSION SPECIFIED IN MY MODEL URL OR PROJECT CONFIGURATION]
